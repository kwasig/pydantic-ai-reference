# --- Nebius Token Factory (required for the real thing) ---------------------------
NEBIUS_API_KEY=            # create at https://tokenfactory.nebius.com -> API keys
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507   # run `nebius-agent models` and pick a tool-calling model

# --- Offline / CI: point at the mock server instead ------------------------------
# NEBIUS_BASE_URL=http://127.0.0.1:8008/v1/
# NEBIUS_API_KEY=mock

# --- Tracing (OpenTelemetry) ------------------------------------------------------
TRACE_EXPORTER=file                 # file | console | otlp | none
TRACE_FILE=traces/spans.jsonl
OTEL_SERVICE_NAME=nebius-pydantic-ai-reference
# OTLP to any backend (Langfuse, Arize Phoenix, Grafana Tempo, LangSmith, Honeycomb...)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20...
# Langfuse shortcut (we build the OTLP endpoint + Basic auth header for you)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com   # or your self-hosted Langfuse on Nebius

# --- Optional tools ----------------------------------------------------------------
# TAVILY_API_KEY=tvly-...            # live web grounding via Tavily (Nebius)
# DAYTONA_API_KEY=...                # run_python in a Daytona sandbox
# ALLOW_LOCAL_EXEC=1                 # or run_python in a local subprocess (dev only)
